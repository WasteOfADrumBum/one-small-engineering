    "package-archive-inspection": {
      "automation": "full",
      "collectors": [
        "release-packaging"
      ]
    },
    "supply-chain-review": {
      "automation": "partial",
      "collectors": [
        "dependency-audit"
      ]
    },
    "ci-release-pipeline": {
      "automation": "partial",
      "collectors": [
        "release-packaging"
      ]
    },
    "versioning-changelog": {
      "automation": "full",
      "collectors": [
