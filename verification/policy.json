{
  "$comment": "Verification governance (Phase 4, docs/verification.md). Owner-controlled: change only through a reviewed PR that Joshua Small approves. Collectors and the orchestrator read this file and never write it. Its sha256 is part of every evidence cache key, so a rule change invalidates cached evidence.",
  "policyVersion": 1,
  "collectorIdentity": "One Small Engineering Verify",
  "freshness": {
    "defaultDays": 30,
    "byCollector": {
      "ci-results": 7,
      "dependency-audit": 7,
      "deployment-health": 1
    }
  },
  "aiVerifiers": {
    "$comment": "An AI tool may verify only when listed here for the project, with a distinguishable identity, a re-executed or reviewed method backed by reproducible evidence, and never for a project whose builder is the same tool family. Empty means no AI tool may act as a verifier.",
    "allowed": []
  },
  "toolFamilies": {
    "$comment": "Identity names (lower case, substring match) that belong to one AI tool family. A verifier in the same family as the builder is never independent.",
    "claude": [
      "claude",
      "claude code",
      "anthropic"
    ],
    "openai": [
      "chatgpt",
      "codex",
      "openai",
      "gpt"
    ],
    "copilot": [
      "copilot",
      "github copilot"
    ],
    "gemini": [
      "gemini",
      "google gemini"
    ]
  },
  "humanOnlyGates": [
    "no-release-blockers",
    "scope-complete",
    "keyboard-screen-reader"
  ],
  "gates": {
    "scope-complete": {
      "automation": "none",
      "collectors": []
    },
    "automated-checks": {
      "automation": "full",
      "collectors": [
        "build-test",
        "lint-format-types",
        "ci-results"
      ]
    },
    "security-privacy-review": {
      "automation": "partial",
      "collectors": [
        "secret-scan"
      ],
      "supporting": [
        "dependency-audit"
      ]
    },
    "wcag-22-aa": {
      "automation": "partial",
      "collectors": [
        "accessibility"
      ]
    },
    "keyboard-screen-reader": {
      "automation": "none",
      "collectors": []
    },
    "responsive-layouts": {
      "automation": "none",
      "collectors": []
    },
    "critical-workflows": {
      "automation": "partial",
      "collectors": [
        "build-test"
      ]
    },
    "production-deployment": {
      "automation": "partial",
      "collectors": [
