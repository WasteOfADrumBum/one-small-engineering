{
  "name": "one-small-engineering",
  "version": "1.0.0",
  "private": true,
  "description": "Central project registry, engineering standards, release governance and audit evidence for the One Small ecosystem.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-registry.mjs",
    "test": "node --test scripts/*.test.mjs scripts/sync/*.test.mjs scripts/release/*.test.mjs scripts/verify/*.test.mjs scripts/engineering/*.test.mjs",
    "check": "npm run validate && npm test",
    "onboard": "node scripts/sync/onboard.mjs",
    "sync:preview": "node scripts/sync/run.mjs preview",
    "sync:pilot": "node scripts/sync/pilot.mjs",
    "readiness": "node scripts/readiness.mjs",
    "release:assess": "node scripts/release/cli.mjs assess",
    "release:dashboard": "node scripts/release/cli.mjs dashboard",
    "release:prepare": "node scripts/release/cli.mjs prepare",
    "release:reports": "node scripts/release/cli.mjs reports",
    "release:check": "node scripts/release/cli.mjs check",
    "verify:run": "node scripts/verify/cli.mjs run",
    "verify:report": "node scripts/verify/cli.mjs report",
    "verify:check": "node scripts/verify/cli.mjs check",
    "verify:freshness": "node scripts/verify/cli.mjs freshness",
    "verify:record": "node scripts/verify/cli.mjs record",
    "verify:remediate": "node scripts/verify/cli.mjs remediate",
    "engineering:check": "node scripts/engineering/cli.mjs check",
    "engineering:report": "node scripts/engineering/cli.mjs report",
    "engineering:prepare": "node scripts/engineering/cli.mjs prepare",
    "engineering:execute": "node scripts/engineering/cli.mjs execute"
  }
}
