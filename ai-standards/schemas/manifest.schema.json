{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WasteOfADrumBum/one-small-engineering/blob/main/ai-standards/schemas/manifest.schema.json",
  "title": "One Small AI Engineering Standards: source manifest",
  "description": "ai-standards/manifest.json: the canonical list of policies, templates and agent adapters, with checksums. Validated by scripts/ai/source.mjs using the hub's dependency-free schema checker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "repository", "policyVersion", "policies", "templates", "adapters", "defaultAdapters", "projectTemplate", "history", "limits"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "policyVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "policies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceFile" } },
    "templates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceFile" } },
    "adapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/adapter" } },
    "defaultAdapters": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "projectTemplate": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keep"],
      "properties": { "keep": { "type": "integer", "minimum": 1 } }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chatgptMaxChars"],
      "properties": { "chatgptMaxChars": { "type": "integer", "minimum": 1000 } }
    }
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "file": { "type": "string", "pattern": "^(policies|templates)/[a-z0-9.-]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "path", "template", "createIfMissing"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["block", "file"] },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "template": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "createIfMissing": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
